rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function classPath(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function userExists(uid) {
      return exists(userPath(uid));
    }

    function rolesOf(uid) {
      return get(userPath(uid)).data.roles;
    }

    function isAssistant() {
      return isSignedIn()
        && userExists(currentUid())
        && 'asisten' in rolesOf(currentUid());
    }

    // Peran Aslab hanya dapat diberikan manual via Firebase Console (SRS 019).
    function isAslab() {
      return isSignedIn()
        && userExists(currentUid())
        && 'aslab' in rolesOf(currentUid());
    }

    function classExists(classId) {
      return exists(classPath(classId));
    }

    function isClassAssistant(classId) {
      return isSignedIn()
        && classExists(classId)
        && currentUid() in get(classPath(classId)).data.assistants;
    }

    function isClassMember(classId) {
      return isSignedIn()
        && classExists(classId)
        && currentUid() in get(classPath(classId)).data.memberIds;
    }

    function isClassMemberUid(classId, uid) {
      return classExists(classId)
        && uid in get(classPath(classId)).data.memberIds;
    }

    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function changedAny(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // ─── users ───────────────────────────────────────────────────────────────
    // Role hanya boleh diberikan lewat jalur tepercaya (Firebase Console /
    // Admin SDK). Pengguna tidak pernah boleh mengubah `roles` miliknya.

    match /users/{userId} {
      function isSelf() {
        return isSignedIn() && currentUid() == userId;
      }

      // Profil sendiri, dibaca asisten untuk pencarian peserta kelas, atau
      // dibaca aslab untuk distribusi praktikan.
      allow read: if isSelf() || isAssistant() || isAslab();

      allow create: if isSelf()
        && onlyFields(['uid', 'nama', 'nim', 'email', 'roles', 'activeRole', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'nama', 'nim', 'email', 'roles', 'activeRole', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 1
        && request.resource.data.nama.size() <= 100
        && request.resource.data.nim is string
        && request.resource.data.nim.matches('^[0-9]{14}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.roles == ['praktikan']
        && request.resource.data.activeRole == null
        && request.resource.data.createdAt == request.time;

      // `roles` dan `uid` tidak boleh berubah: cegah eskalasi peran.
      allow update: if isSelf()
        && changedOnly(['nama', 'nim', 'activeRole', 'fcmToken', 'fcmTokenUpdatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.nama is string
        && request.resource.data.nim is string
        && (request.resource.data.activeRole == null
            || request.resource.data.activeRole in resource.data.roles);

      allow delete: if false;
    }

    // ─── classes ─────────────────────────────────────────────────────────────

    match /classes/{classId} {
      allow read: if isSignedIn()
        && (currentUid() in resource.data.assistants
            || currentUid() in resource.data.memberIds
            || isAssistant()
            || isAslab());

      allow create: if (isAssistant() || isAslab())
        && onlyFields([
          'mataKuliah', 'kodeKelas', 'assistants', 'createdBy', 'memberIds',
          'labId', 'ruang', 'gracePeriodMinutes', 'fineAmount', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'mataKuliah', 'kodeKelas', 'assistants', 'createdBy', 'memberIds',
          'createdAt'
        ])
        && request.resource.data.createdBy == currentUid()
        && request.resource.data.assistants == [currentUid()]
        && request.resource.data.memberIds == []
        && request.resource.data.mataKuliah is string
        && request.resource.data.mataKuliah.size() >= 1
        && request.resource.data.mataKuliah.size() <= 100
        && request.resource.data.kodeKelas is string
        && request.resource.data.kodeKelas.size() >= 1
        && request.resource.data.kodeKelas.size() <= 10
        && (!('labId' in request.resource.data)
            || request.resource.data.labId == null
            || request.resource.data.labId is string)
        && (!('ruang' in request.resource.data)
            || request.resource.data.ruang == null
            || request.resource.data.ruang is string)
        && (!('gracePeriodMinutes' in request.resource.data)
            || (request.resource.data.gracePeriodMinutes is number
                && request.resource.data.gracePeriodMinutes >= 0
                && request.resource.data.gracePeriodMinutes <= 120))
        && (!('fineAmount' in request.resource.data)
            || (request.resource.data.fineAmount is number
                && request.resource.data.fineAmount > 0
                && request.resource.data.fineAmount <= 10000000))
        && request.resource.data.createdAt == request.time;

      // Asisten hanya boleh mengubah informasi kelas. Distribusi peserta
      // (memberIds) dan konfigurasi lab/denda merupakan wewenang Aslab (SRS 019).
      allow update: if isClassAssistant(classId)
        && changedOnly(['mataKuliah', 'kodeKelas'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.assistants == resource.data.assistants
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.mataKuliah is string
        && request.resource.data.mataKuliah.size() >= 1
        && request.resource.data.mataKuliah.size() <= 100
        && request.resource.data.kodeKelas is string
        && request.resource.data.kodeKelas.size() >= 1
        && request.resource.data.kodeKelas.size() <= 10;

      allow update: if isAslab()
        && changedOnly([
          'mataKuliah', 'kodeKelas', 'memberIds', 'labId', 'ruang',
          'gracePeriodMinutes', 'fineAmount'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.assistants == resource.data.assistants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberIds is list
        && request.resource.data.mataKuliah is string
        && request.resource.data.mataKuliah.size() >= 1
        && request.resource.data.mataKuliah.size() <= 100
        && request.resource.data.kodeKelas is string
        && request.resource.data.kodeKelas.size() >= 1
        && request.resource.data.kodeKelas.size() <= 10
        && (!('labId' in request.resource.data)
            || request.resource.data.labId == null
            || request.resource.data.labId is string)
        && (!('ruang' in request.resource.data)
            || request.resource.data.ruang == null
            || request.resource.data.ruang is string)
        && (!('gracePeriodMinutes' in request.resource.data)
            || (request.resource.data.gracePeriodMinutes is number
                && request.resource.data.gracePeriodMinutes >= 0
                && request.resource.data.gracePeriodMinutes <= 120))
        && (!('fineAmount' in request.resource.data)
            || (request.resource.data.fineAmount is number
                && request.resource.data.fineAmount > 0
                && request.resource.data.fineAmount <= 10000000));

      allow delete: if isClassAssistant(classId) || isAslab();

      // ─── classes/{classId}/members ─────────────────────────────────────────
      // Penambahan/penghapusan peserta hanya oleh Aslab (SRS 019).

      match /members/{memberId} {
        allow read: if isClassAssistant(classId)
          || isAslab()
          || (isSignedIn() && currentUid() == memberId);

        // Aslab tidak boleh mendaftarkan dirinya sendiri / asisten pengampu kelas sebagai peserta.
        allow create: if isAslab()
          && memberId != classId
          && memberId != currentUid()
          && !(memberId in get(classPath(classId)).data.assistants)
          && userExists(memberId)
          && 'praktikan' in rolesOf(memberId)
          && onlyFields(['uid', 'nama', 'nim', 'email', 'joinedAt'])
          && request.resource.data.keys().hasAll(['uid', 'nama', 'nim', 'email', 'joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.nama is string
          && request.resource.data.nim is string
          && request.resource.data.email is string
          && request.resource.data.joinedAt == request.time;

        allow update: if isAslab()
          && changedOnly(['nama', 'nim', 'email'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.joinedAt == resource.data.joinedAt;

        allow delete: if isAslab();
      }
    }

    // ─── schedules ───────────────────────────────────────────────────────────

    match /schedules/{scheduleId} {
      // Asisten/aslab perlu membaca lintas jadwal untuk deteksi bentrok (SRS 019).
      allow read: if isSignedIn()
        && (currentUid() in resource.data.assistants
            || isClassMember(resource.data.classId)
            || isAssistant()
            || isAslab());

      allow create: if isAssistant()
        && isClassAssistant(request.resource.data.classId)
        && onlyFields([
          'classId', 'mataKuliah', 'kodeKelas', 'nomorPraktikum',
          'namaPraktikum', 'tanggal', 'jamMulai', 'jamSelesai', 'ruang',
          'labId', 'assistants', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'classId', 'mataKuliah', 'kodeKelas', 'nomorPraktikum',
          'namaPraktikum', 'tanggal', 'jamMulai', 'jamSelesai', 'ruang',
          'assistants', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdBy == currentUid()
        && request.resource.data.assistants == get(classPath(request.resource.data.classId)).data.assistants
        && request.resource.data.mataKuliah is string
        && request.resource.data.mataKuliah.size() >= 1
        && request.resource.data.kodeKelas is string
        && request.resource.data.nomorPraktikum is number
        && request.resource.data.nomorPraktikum > 0
        && request.resource.data.nomorPraktikum <= 100
        && request.resource.data.namaPraktikum is string
        && request.resource.data.namaPraktikum.size() >= 1
        && request.resource.data.namaPraktikum.size() <= 150
        && request.resource.data.tanggal is timestamp
        && request.resource.data.jamMulai is timestamp
        && request.resource.data.jamSelesai is timestamp
        && request.resource.data.ruang is string
        && request.resource.data.ruang.size() >= 1
        && request.resource.data.ruang.size() <= 100
        && (!('labId' in request.resource.data)
            || request.resource.data.labId == null
            || request.resource.data.labId is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Jadwal tidak boleh dipindah ke kelas lain / diubah kepemilikannya.
      allow update: if isClassAssistant(resource.data.classId)
        && changedOnly([
          'classId', 'mataKuliah', 'kodeKelas', 'nomorPraktikum', 'namaPraktikum',
          'tanggal', 'jamMulai', 'jamSelesai', 'ruang', 'labId', 'assistants',
          'updatedAt'
        ])
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.assistants == resource.data.assistants
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.mataKuliah is string
        && request.resource.data.kodeKelas is string
        && request.resource.data.nomorPraktikum is number
        && request.resource.data.nomorPraktikum > 0
        && request.resource.data.nomorPraktikum <= 100
        && request.resource.data.namaPraktikum is string
        && request.resource.data.namaPraktikum.size() >= 1
        && request.resource.data.namaPraktikum.size() <= 150
        && request.resource.data.tanggal is timestamp
        && request.resource.data.jamMulai is timestamp
        && request.resource.data.jamSelesai is timestamp
        && request.resource.data.ruang is string
        && request.resource.data.ruang.size() >= 1
        && request.resource.data.ruang.size() <= 100
        && request.resource.data.updatedAt == request.time;

      allow delete: if isClassAssistant(resource.data.classId);
    }

    // ─── sessions ────────────────────────────────────────────────────────────
    // Hanya asisten pengampu kelas yang boleh membuka/menutup sesi.

    match /sessions/{sessionId} {
      allow read: if isSignedIn()
        && (isClassAssistant(resource.data.classId)
            || isClassMember(resource.data.classId)
            || isAslab());

      allow create: if isAssistant()
        && request.resource.data.scheduleId == sessionId
        && isClassAssistant(request.resource.data.classId)
        && existsAfter(/databases/$(database)/documents/schedules/$(sessionId))
        && onlyFields([
          'scheduleId', 'classId', 'kodeKelas', 'kodePresensi', 'status',
          'openedAt', 'closedAt', 'openedBy', 'closedBy', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'scheduleId', 'classId', 'kodeKelas', 'status', 'openedAt', 'closedAt',
          'openedBy', 'closedBy', 'updatedBy', 'updatedAt'
        ])
        && (!('kodePresensi' in request.resource.data)
            || (request.resource.data.kodePresensi is string
                && request.resource.data.kodePresensi.matches('^[A-Z0-9]{4,8}$')))
        && request.resource.data.status == 'scheduled'
        && request.resource.data.openedAt == null
        && request.resource.data.closedAt == null
        && request.resource.data.openedBy == null
        && request.resource.data.closedBy == null
        && request.resource.data.updatedBy == currentUid()
        && request.resource.data.updatedAt == request.time;

      allow update: if isClassAssistant(resource.data.classId)
        && request.resource.data.scheduleId == resource.data.scheduleId
        && request.resource.data.classId == resource.data.classId
        && (request.resource.data.updatedBy == currentUid()
            || request.resource.data.updatedBy == 'system')
        && changedOnly([
          'status', 'openedAt', 'closedAt', 'openedBy', 'closedBy',
          'updatedBy', 'updatedAt', 'kodeKelas', 'kodePresensi',
          'gracePeriodMinutes', 'fineAmount'
        ])
        && (!('kodePresensi' in request.resource.data)
            || (request.resource.data.kodePresensi is string
                && request.resource.data.kodePresensi.matches('^[A-Z0-9]{4,8}$')))
        && (!('gracePeriodMinutes' in request.resource.data)
            || (request.resource.data.gracePeriodMinutes is number
                && request.resource.data.gracePeriodMinutes >= 0
                && request.resource.data.gracePeriodMinutes <= 120))
        && (!('fineAmount' in request.resource.data)
            || (request.resource.data.fineAmount is number
                && request.resource.data.fineAmount > 0
                && request.resource.data.fineAmount <= 10000000))
        && request.resource.data.status in ['scheduled', 'open', 'closed']
        && request.resource.data.kodeKelas is string
        && request.resource.data.updatedAt == request.time
        && (
          !changedAny(['status'])
          || (
            request.resource.data.status == 'open'
            && request.resource.data.openedBy == currentUid()
            && request.resource.data.openedAt == request.time
            && request.resource.data.closedAt == null
            && request.resource.data.closedBy == null
          )
          || (
            request.resource.data.status == 'closed'
            && (request.resource.data.closedBy == currentUid()
                || request.resource.data.closedBy == 'system')
            && request.resource.data.closedAt == request.time
          )
        );

      allow delete: if isClassAssistant(resource.data.classId);

      // ─── sessions/{sessionId}/attendance ───────────────────────────────────

      match /attendance/{studentId} {
        allow read: if isSignedIn()
          && (studentId == currentUid()
              || isClassAssistant(get(sessionPath(sessionId)).data.classId)
              || isAslab());

        // Praktikan hanya boleh mencatat kehadirannya sendiri, pada sesi
        // yang sedang dibuka dan di kelas yang ia ikuti (SRS 007/020).
        allow create: if isSignedIn()
          && studentId == currentUid()
          && exists(sessionPath(sessionId))
          && get(sessionPath(sessionId)).data.status == 'open'
          && isClassMember(get(sessionPath(sessionId)).data.classId)
          && onlyFields([
            'studentId', 'nama', 'nim', 'sessionId', 'waktuHadir',
            'latitude', 'longitude', 'jarakMeter', 'radiusMeter',
            'attendanceStatus', 'latenessStatus', 'lateMinutes', 'fineId'
          ])
          && request.resource.data.keys().hasAll([
            'studentId', 'nama', 'nim', 'sessionId', 'waktuHadir',
            'attendanceStatus', 'latenessStatus', 'lateMinutes', 'fineId'
          ])
          && request.resource.data.studentId == currentUid()
          && request.resource.data.sessionId == sessionId
          && request.resource.data.nama is string
          && request.resource.data.nama.size() >= 1
          && request.resource.data.nim is string
          && request.resource.data.waktuHadir == request.time
          && request.resource.data.attendanceStatus == 'hadir'
          && request.resource.data.latenessStatus in ['on_time', 'late']
          && request.resource.data.lateMinutes is number
          && request.resource.data.lateMinutes >= 0
          && request.resource.data.fineId == null
          && (!('latitude' in request.resource.data) || request.resource.data.latitude is number)
          && (!('longitude' in request.resource.data) || request.resource.data.longitude is number)
          && (!('jarakMeter' in request.resource.data) || request.resource.data.jarakMeter is number)
          && (!('radiusMeter' in request.resource.data) || request.resource.data.radiusMeter is number);

        // Izin disetujui dicatat oleh asisten pengampu sebagai excused, bebas
        // denda, dan bukan kehadiran fisik (SRS 020).
        allow create: if isSignedIn()
          && isClassAssistant(get(sessionPath(sessionId)).data.classId)
          && isClassMemberUid(get(sessionPath(sessionId)).data.classId, studentId)
          && onlyFields([
            'studentId', 'nama', 'nim', 'sessionId', 'waktuHadir',
            'latitude', 'longitude', 'jarakMeter', 'radiusMeter',
            'attendanceStatus', 'latenessStatus', 'lateMinutes', 'fineId'
          ])
          && request.resource.data.keys().hasAll([
            'studentId', 'nama', 'nim', 'sessionId', 'waktuHadir',
            'attendanceStatus', 'latenessStatus', 'lateMinutes', 'fineId'
          ])
          && request.resource.data.studentId == studentId
          && request.resource.data.sessionId == sessionId
          && request.resource.data.nama is string
          && request.resource.data.nim is string
          && request.resource.data.waktuHadir == request.time
          && request.resource.data.attendanceStatus == 'izin'
          && request.resource.data.latenessStatus == 'excused'
          && request.resource.data.lateMinutes == 0
          && request.resource.data.fineId == null
          && (!('latitude' in request.resource.data) || request.resource.data.latitude == null)
          && (!('longitude' in request.resource.data) || request.resource.data.longitude == null)
          && (!('jarakMeter' in request.resource.data) || request.resource.data.jarakMeter == null)
          && (!('radiusMeter' in request.resource.data) || request.resource.data.radiusMeter == null);

        // Praktikan hanya boleh menautkan fineId denda miliknya (tidak boleh
        // mengubah status kehadiran/keterlambatan).
        allow update: if isSignedIn()
          && studentId == currentUid()
          && changedOnly(['fineId'])
          && (request.resource.data.fineId == null
              || request.resource.data.fineId is string);

        allow delete: if false;
      }
    }

    // ─── permissionRequests ──────────────────────────────────────────────────
    // Praktikan hanya membuat & membaca pengajuannya sendiri. Keputusan izin
    // hanya boleh diubah sekali oleh asisten pengampu kelas terkait.

    match /permissionRequests/{permissionId} {
      allow read: if isSignedIn()
        && (resource.data.uid == currentUid()
            || isClassAssistant(resource.data.classId));

      allow create: if isSignedIn()
        && onlyFields([
          'uid', 'nama', 'nim', 'classId', 'sessionId', 'mataKuliah',
          'namaPraktikum', 'nomorPraktikum', 'alasan', 'status', 'aiStatus',
          'aiCategory', 'aiConfidence', 'aiProcessedAt', 'decidedBy',
          'decidedAt', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'nama', 'nim', 'classId', 'sessionId', 'mataKuliah',
          'namaPraktikum', 'nomorPraktikum', 'alasan', 'status', 'aiStatus',
          'aiCategory', 'aiConfidence', 'aiProcessedAt', 'decidedBy',
          'decidedAt', 'createdAt'
        ])
        && request.resource.data.uid == currentUid()
        && request.resource.data.status == 'pending'
        && request.resource.data.decidedBy == null
        && request.resource.data.decidedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.aiStatus in ['success', 'failed']
        && (request.resource.data.aiCategory == null
            || request.resource.data.aiCategory in ['positif', 'netral', 'negatif'])
        && (request.resource.data.aiConfidence == null
            || (request.resource.data.aiConfidence is number
                && request.resource.data.aiConfidence >= 0
                && request.resource.data.aiConfidence <= 1))
        && (request.resource.data.aiProcessedAt == null
            || request.resource.data.aiProcessedAt == request.time)
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() >= 1
        && request.resource.data.alasan.size() <= 2000
        && request.resource.data.nama is string
        && request.resource.data.nim is string
        && request.resource.data.mataKuliah is string
        && request.resource.data.namaPraktikum is string
        && request.resource.data.nomorPraktikum is number
        && request.resource.data.nomorPraktikum > 0
        && request.resource.data.nomorPraktikum <= 100
        && isClassMember(request.resource.data.classId)
        && exists(sessionPath(request.resource.data.sessionId))
        && get(sessionPath(request.resource.data.sessionId)).data.classId == request.resource.data.classId;

      // Keputusan hanya boleh dari pending → approved/rejected, sekali saja,
      // dan tidak boleh memutuskan pengajuan milik sendiri.
      allow update: if isClassAssistant(resource.data.classId)
        && resource.data.uid != currentUid()
        && changedOnly(['status', 'decidedBy', 'decidedAt'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedBy == currentUid()
        && request.resource.data.decidedAt == request.time;

      // Penandaan pencatatan izin (excusedRecorded) oleh asisten setelah
      // dokumen attendance izin dibuat (SRS 020).
      allow update: if isClassAssistant(resource.data.classId)
        && resource.data.status == 'approved'
        && changedOnly(['excusedRecorded'])
        && request.resource.data.excusedRecorded == true;

      allow delete: if false;
    }

    // ─── laboratories ────────────────────────────────────────────────────────
    // Lokasi & radius laboratorium dibaca oleh praktikan dan asisten untuk
    // validasi lokasi presensi (SRS-014), serta dikelola oleh Aslab (SRS-019).

    match /laboratories/{labId} {
      allow read: if isSignedIn();

      allow create: if isAslab()
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 1
        && request.resource.data.nama.size() <= 100
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radius is number
        && request.resource.data.radius >= 5
        && request.resource.data.radius <= 10000
        && request.resource.data.aktif is bool
        && request.resource.data.updatedBy == currentUid()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAslab()
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 1
        && request.resource.data.nama.size() <= 100
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radius is number
        && request.resource.data.radius >= 5
        && request.resource.data.radius <= 10000
        && request.resource.data.aktif is bool
        && request.resource.data.updatedBy == currentUid()
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAslab();
    }

    // ─── fines ───────────────────────────────────────────────────────────────
    // Tagihan denda keterlambatan (SRS 020). ID deterministik
    // `{sessionId}_{studentId}` menjamin satu denda per sesi/praktikan.

    match /fines/{fineId} {
      allow read: if isSignedIn()
        && (resource.data.studentId == currentUid()
            || isClassAssistant(resource.data.classId)
            || isAslab());

      // Praktikan membuat denda miliknya sendiri; status awal wajib unpaid.
      allow create: if isSignedIn()
        && request.resource.data.studentId == currentUid()
        && request.resource.data.fineId == fineId
        && request.resource.data.status == 'unpaid'
        && request.resource.data.latestOrderId == null
        && request.resource.data.paidAt == null
        && isClassMember(request.resource.data.classId)
        && exists(sessionPath(request.resource.data.sessionId))
        && request.resource.data.sessionId + '_' + currentUid() == fineId
        && onlyFields([
          'fineId', 'studentId', 'nama', 'nim', 'sessionId', 'classId',
          'kodeKelas', 'mataKuliah', 'nomorPraktikum', 'namaPraktikum',
          'ruang', 'labId', 'waktuHadir', 'lateMinutes', 'gracePeriodMinutes',
          'nominal', 'status', 'latestOrderId', 'paidAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'fineId', 'studentId', 'nama', 'nim', 'sessionId', 'classId',
          'kodeKelas', 'mataKuliah', 'nomorPraktikum', 'namaPraktikum',
          'ruang', 'labId', 'waktuHadir', 'lateMinutes', 'gracePeriodMinutes',
          'nominal', 'status', 'latestOrderId', 'paidAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.nominal is number
        && request.resource.data.nominal > 0
        && request.resource.data.lateMinutes is number
        && request.resource.data.lateMinutes >= 0
        && request.resource.data.gracePeriodMinutes is number
        && request.resource.data.gracePeriodMinutes >= 0
        && request.resource.data.waktuHadir is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Pembayaran hanya mengubah status pembayaran, tidak pernah
      // attendance/lateness.
      allow update: if isAslab()
        && changedOnly(['status', 'latestOrderId', 'paidAt', 'updatedAt'])
        && request.resource.data.status in ['unpaid', 'pending', 'paid', 'failed']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ─── paymentTransactions ─────────────────────────────────────────────────
    // Riwayat transaksi pembayaran denda (SRS 020/021).

    match /paymentTransactions/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.studentId == currentUid() || isAslab());

      allow create: if isSignedIn()
        && (request.resource.data.studentId == currentUid() || isAslab())
        && request.resource.data.orderId == orderId
        && request.resource.data.status in ['pending', 'paid', 'failed', 'expired']
        && onlyFields([
          'orderId', 'fineId', 'studentId', 'sessionId', 'nominal', 'status',
          'paidAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'orderId', 'fineId', 'studentId', 'sessionId', 'nominal', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.nominal is number
        && request.resource.data.nominal > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAslab()
        && changedOnly(['status', 'paidAt', 'updatedAt'])
        && request.resource.data.status in ['pending', 'paid', 'failed', 'expired']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ─── notifications ────────────────────────────────────────────────────────
    // SRS-017: Notifikasi kegiatan praktikum (sesi dibuka, jadwal diubah, izin)
    match /notifications/{notificationId} {
      // Praktikan atau asisten dapat membaca notifikasi yang ditujukan kepadanya
      allow read: if isSignedIn() && resource.data.recipientUid == currentUid();

      // Pengguna terautentikasi dapat membuat notifikasi
      allow create: if isSignedIn();

      // Penerima dapat menandai notifikasi telah dibaca
      allow update: if isSignedIn()
        && resource.data.recipientUid == currentUid()
        && changedOnly(['isRead']);

      allow delete: if isSignedIn() && resource.data.recipientUid == currentUid();
    }

    // Tolak semua akses ke collection lain.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
